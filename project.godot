; Engine configuration file.
; MOTO HOP — Godot 4.7.2 stable, Compatibility renderer, mobile-web-first.

config_version=5

[application]

config/name="Moto Hop"
run/main_scene="res://src/core/moto_hop.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
GameState="*res://src/core/game_state.gd"
InputManager="*res://src/platform/input_manager.gd"
AudioManager="*res://src/audio/audio_manager.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
